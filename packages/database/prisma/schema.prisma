generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  OPERATOR
}

model PlcTelemetry {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())

  inJamAir        Int @map("in_jam_air")
  inJamLampuHidup Int @map("in_jam_lampu_hidup")
  inJamLampuMati  Int @map("in_jam_lampu_mati")
  inMenitAir      Int @map("in_menit_air")

  outEc         Float @map("out_ec")
  outKadarAir   Float @map("out_kadar_air")
  outKalium     Float @map("out_kalium")
  outKelembaban Float @map("out_kelembaban")
  outNitrogen   Float @map("out_nitrogen")
  outPh         Float @map("out_ph")
  outPhospor    Float @map("out_phospor")
  outSuhu       Float @map("out_suhu")

  pupukToggle Int @map("pupuk_toggle")

  activityLogs ActivityLog[]
  report       PerformanceReport? @relation(fields: [reportId], references: [id])
  reportId     Int?               @map("report_id")
}

model User {
  id       Int      @id @default(autoincrement())
  name     String   @unique
  password String
  role     UserRole

  activityLogs ActivityLog[]
}

model IrrigationZone {
  id            Int       @id @default(autoincrement())
  name          String
  status        String
  lajuAlir      Float
  targetDurasi  String
  targetNpk     String
  terakhirJalan DateTime?

  mulaiTanam  DateTime? @map("mulai_tanam")
  targetPanen DateTime? @map("target_panen")
  siklusDasar Int?      @map("siklus_dasar")

  fertigasi FertigasiZone?
  valves    ValveControl[]
}

model FertigasiZone {
  id         Int    @id @default(autoincrement())
  faseTumbuh String @map("fase_tumbuh")

  dosisNitrogen Int @map("dosis_nitrogen")
  dosisPosfor   Int @map("dosis_posfor")
  dosisKalium   Int @map("dosis_kalium")

  targetEcMin Float @map("target_ec_min")
  targetEcMax Float @map("target_ec_max")
  targetPhMin Float @map("target_ph_min")
  targetPhMax Float @map("target_ph_max")

  zona   IrrigationZone @relation(fields: [zonaId], references: [id])
  zonaId Int            @unique @map("zona_id")

  updatedAt DateTime @updatedAt @map("updated_at")
}

model ValveControl {
  id     Int     @id @default(autoincrement())
  name   String
  type   String
  isOpen Boolean @default(false) @map("is_open")

  zona   IrrigationZone? @relation(fields: [zonaId], references: [id])
  zonaId Int?            @map("zona_id")

  updatedAt DateTime @updatedAt @map("updated_at")
}

model PLCSetting {
  id                Int    @id @default(autoincrement())
  ipAddress         String @map("ip_address")
  heartbeatInterval Int    @map("heartbeat_interval")
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  category  String
  activity  String
  status    String

  telemetry   PlcTelemetry? @relation(fields: [telemetryId], references: [id])
  telemetryId Int?          @map("telemetry_id")
  user        User?         @relation(fields: [userId], references: [id])
  userId      Int?
}

model PerformanceReport {
  id              Int      @id @default(autoincrement())
  date            DateTime @unique
  estimasiHasil   Float    @map("estimasi_hasil")
  penggunaanAir   Float    @map("penggunaan_air")
  konsumsiNutrisi Float    @map("konsumsi_nutrisi")
  waktuAktifCo2   Float    @map("waktu_aktif_co2")

  telemetryData PlcTelemetry[]
}
